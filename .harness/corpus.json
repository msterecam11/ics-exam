    {
      "name": "corpus-m2s2",
      "master": "content_white",
      "title": "Building a GSE Safety Culture",
      "shape": "body>radial",
      "blueprint": {
        "gap": "lg",
        "type": "stack",
        "children": [
          {
            "size": "lead",
            "text": [
              {
                "text": "Ramp safety is not the responsibility of the last technician who touched the equipment — it belongs to "
              },
              {
                "bold": true,
                "text": "everyone who operates, dispatches, or authorizes GSE for use.",
                "highlight": "token:tab-yellow"
              }
            ],
            "type": "body"
          },
          {
            "hub": {
              "icon": "shield-check",
              "heading": "Shared Responsibility"
            },
            "type": "radial",
            "style": {
              "fill": "filled",
              "accent": "token:primary-dark",
              "corner": "round",
              "density": "normal",
              "elevation": "ring"
            },
            "spokes": [
              {
                "body": "Verify inspection compliance, authorize equipment for use, enforce corrective action.",
                "icon": "user-gear",
                "heading": "Supervisors"
              },
              {
                "body": "Perform the physical checks and accurately report defects.",
                "icon": "wrench",
                "heading": "Technicians"
              },
              {
                "body": "Skipped checks, undocumented defects, and informal sign-offs are a direct precursor to ramp incidents, ground damage, and injury.",
                "icon": "warning",
                "heading": "Weak Culture"
              },
              {
                "body": "Complete checklists, timely reporting, and enforced sign-off are the control most directly linked to reduced GSE-related incident rates.",
                "icon": "check-circle",
                "heading": "Inspection Discipline"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "corpus-m2s3",
      "master": "content_white",
      "title": "Pre-Operation Inspection Checklist",
      "shape": "heading>table>row",
      "blueprint": {
        "gap": "lg",
        "type": "stack",
        "children": [
          {
            "icon": "clipboard-text",
            "text": "Two-Part Checklist",
            "type": "heading",
            "color": "token:primary-dark",
            "level": 4,
            "accentBar": true
          },
          {
            "rows": [
              {
                "cells": [
                  {
                    "text": "CHECK TYPE"
                  },
                  {
                    "text": "ITEMS VERIFIED"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "bold": true,
                    "text": "Visual Inspection"
                  },
                  {
                    "text": "Tyres and wheels · Hydraulic or fuel leaks · Structural damage · Lighting and reflective markings · Condition of safety guards/rails"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "bold": true,
                    "text": "Functional / Operational Checks"
                  },
                  {
                    "text": "Braking system · Steering response · Lift or elevation mechanism · Horn/backup alarm · Interlocks or emergency stop controls"
                  }
                ]
              }
            ],
            "type": "table",
            "headerRow": true
          },
          {
            "gap": "md",
            "type": "row",
            "weights": [
              1,
              1
            ],
            "children": [
              {
                "text": "Any defect found during a visual or functional check must be logged — date, unit ID, defect description, and inspector name.",
                "tone": "requirement",
                "type": "callout",
                "label": "DOCUMENTATION"
              },
              {
                "text": "Equipment stays off the ramp until a qualified inspector or supervisor signs off the checklist as serviceable, or formally removes the unit from service.",
                "tone": "requirement",
                "type": "callout",
                "label": "DISPATCH GATE"
              }
            ]
          }
        ]
      },
      "decor": {
        "edge": "left",
        "accent": "token:primary-dark"
      }
