    {
      "name": "corpus-m1s2",
      "master": "content_white",
      "title": "The Role of GSE in Ramp Operations",
      "shape": "body>stat-equation>row",
      "blueprint": {
        "gap": "lg",
        "type": "stack",
        "children": [
          {
            "size": "lead",
            "text": [
              {
                "text": "GSE is the mobile and fixed apparatus that services, loads, moves, and supplies aircraft between flights — "
              },
              {
                "bold": true,
                "text": "distinct from the aircraft itself.",
                "highlight": "token:tab-yellow"
              }
            ],
            "type": "body"
          },
          {
            "type": "stat-equation",
            "style": {
              "fill": "tinted",
              "accent": "token:primary-light",
              "corner": "soft",
              "elevation": "raised"
            },
            "terms": [
              {
                "label": "Aircraft Interface",
                "sublabel": "Connects to doors, cargo holds, fuel ports, electrical/pneumatic receptacles"
              },
              {
                "label": "Turnaround Reliability",
                "sublabel": "Positioning and serviceability directly set gate schedule performance"
              },
              {
                "label": "Apron Safety Governance",
                "sublabel": "FOD prevention and vehicle procedures on the movement area"
              }
            ],
            "result": {
              "label": "Ramp Operations Continuity",
              "sublabel": "GSE as the operational link between airside and aircraft"
            }
          },
          {
            "gap": "md",
            "type": "row",
            "weights": [
              1,
              1
            ],
            "children": [
              {
                "icon": "clock-countdown",
                "text": "Delayed positioning or equipment malfunction is a recognized cause of gate schedule deviation.",
                "type": "icon-row",
                "accent": "token:primary-light"
              },
              {
                "icon": "shield-warning",
                "text": "GSE operates under apron safety and FOD prevention procedures governing vehicles on the movement area.",
                "type": "icon-row",
                "accent": "token:primary-light"
              }
            ]
          }
        ]
      },
      "decor": {
        "icon": "truck",
        "accent": "token:primary-light"
      }
    },
    {
      "name": "corpus-m1s3",
      "master": "content_white",
      "title": "Categories of Ground Support Equipment",
      "shape": "body>row",
      "blueprint": {
        "gap": "lg",
        "type": "stack",
        "children": [
          {
            "size": "lead",
            "text": "GSE is grouped into four functional categories, each defined by the role it plays during aircraft turnaround.",
            "type": "body"
          },
          {
            "gap": "md",
            "type": "row",
            "weights": [
              1,
              1,
              1,
              1
            ],
            "children": [
              {
                "body": "Services the aircraft directly during turnaround — lavatory/water trucks, de-icing rigs, air-conditioning and air-start units.",
                "icon": "truck",
                "type": "icon-tile",
                "accent": "token:primary-light",
                "heading": "Aircraft Servicing"
              },
              {
                "body": "Moves people and freight between terminal and aircraft — boarding stairs and bridges, belt loaders, container/pallet loaders.",
                "icon": "package",
                "type": "icon-tile",
                "accent": "token:primary-light",
                "heading": "Passenger/Cargo Handling"
              },
              {
                "body": "Repositions aircraft and moves loaded dollies and carts across the apron — tow tractors, pushback tugs, baggage tractors.",
                "icon": "tire",
                "type": "icon-tile",
                "accent": "token:primary-light",
                "heading": "Towing & Mobility"
              },
              {
                "body": "Supplies external electrical power and compressed air when aircraft engines or APU are inactive — GPUs, air start units.",
                "icon": "lightning",
                "type": "icon-tile",
                "accent": "token:primary-light",
                "heading": "Power & Pneumatic Supply"
              }
            ]
          }
        ]
      }
    },
